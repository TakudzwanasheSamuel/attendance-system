# Database Configuration
# Replace with your MySQL database connection string
# Format: mysql://username:password@localhost:3306/database_name
DATABASE_URL="mysql://root:password@localhost:3306/attendance_system"

# Google Gemini AI API Key (Optional)
# Get your free API key from: https://makersuite.google.com/app/apikey
# If not provided, the system will use fallback reports without AI analysis
GOOGLE_GENAI_API_KEY="your_gemini_api_key_here"

# JWT Secret for Authentication
# Generate a secure random string for production use
JWT_SECRET="your_jwt_secret_key_here"

# Next.js Configuration
NEXTAUTH_URL="http://localhost:9002"
NEXTAUTH_SECRET="your_nextauth_secret_here"

# Base URL for QR Codes and Mobile Access
# For local development: Use your computer's local IP address (e.g., http://192.168.1.100:9002)
# For production: Use your domain (e.g., https://attendance.yourdomain.com)
# To find your local IP: Windows (ipconfig), Mac/Linux (ifconfig or ip addr)
NEXT_PUBLIC_BASE_URL="http://localhost:9002"

# VPN Detection (Optional but Recommended)
# Get your free API key from: https://www.ipqualityscore.com/create-account
# Free tier: 5,000 requests/month
# If not provided, the system will use fallback detection methods with lower accuracy
IPQUALITYSCORE_API_KEY="your_ipqualityscore_api_key_here"
